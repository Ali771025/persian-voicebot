      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"session_id\": {{$json.session_id}},\n  \"stt\": {{$json.stt}},\n  \"answer\": {{$json.answer}}\n}",
        "options": {}
      },
      "id": "portfolio-node-12",
      "name": "Respond Voice (text only)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1780,
        740
      ]
    }
  ],
